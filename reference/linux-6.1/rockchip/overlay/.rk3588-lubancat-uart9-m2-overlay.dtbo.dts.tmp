# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-uart9-m2-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-uart9-m2-overlay.dts"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&uart9>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "default";
   pinctrl-0 = <&uart9m2_xfer>;
  };
 };
};
