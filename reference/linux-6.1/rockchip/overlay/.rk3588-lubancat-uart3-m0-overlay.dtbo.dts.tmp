# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-uart3-m0-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-uart3-m0-overlay.dts"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&uart3>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "default";
   pinctrl-0 = <&uart3m0_xfer>;
  };
 };
};
