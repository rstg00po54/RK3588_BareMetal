# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-pwm3-ir-m3-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-pwm3-ir-m3-overlay.dts"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&pwm3>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "active";
   pinctrl-0 = <&pwm3m3_pins>;
  };
 };
};
