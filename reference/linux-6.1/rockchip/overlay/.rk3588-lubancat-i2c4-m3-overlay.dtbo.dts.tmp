# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-i2c4-m3-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-i2c4-m3-overlay.dts"
/dts-v1/;
/plugin/;

/ {
 fragment@0 {
  target = <&i2c4>;

  __overlay__ {
   status = "okay";
   pinctrl-names = "default";
   pinctrl-0 = <&i2c4m3_xfer>;
  };
 };
};
