# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 5 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rockchip.h" 1
# 6 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/display/drm_mipi_dsi.h" 1
# 7 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 8 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-dsi1-vp3-virtual-screen-overlay.dts" 2

/ {
 fragment@0 {
  target = <&mipi_dcphy1>;

  __overlay__ {
   status = "okay";
  };
 };

 fragment@1 {
  target = <&route_dsi1>;

  __overlay__ {
   status = "okay";
   connect = <&vp3_out_dsi1>;
  };
 };

 fragment@2 {
  target = <&dsi1_in_vp3>;

  __overlay__ {
   status = "okay";
  };
 };

 fragment@3 {
  target = <&dsi1>;

  __overlay__ {
   status = "okay";
   #address-cells = <1>;
   #size-cells = <0>;

   dsi1_panel: panel@0 {
    status = "okay";
    compatible = "simple-panel-dsi";
    reg = <0>;
    backlight;
    power-supply;
    reset-gpios;

    enable-delay-ms = <35>;
    prepare-delay-ms = <6>;
    reset-delay-ms = <10>;
    init-delay-ms = <50>;
    unprepare-delay-ms = <0>;
    disable-delay-ms = <20>;

    size,width = <74>;
    size,height = <133>;

    dsi,flags = <((1 << 0) | (1 << 1) | (1 << 11) | (1 << 9))>;
    dsi,format = <0>;
    dsi,lanes = <4>;

    panel-init-sequence = [

    ];

    panel-exit-sequence = [

    ];

    disp1_timings0: display-timings {
     native-mode = <&dsi1_timing0>;
     dsi1_timing0: timing0 {
      clock-frequency = <150660000>;
      hactive = <1920>;
      vactive = <1080>;
      hsync-len = <10>;
      hback-porch = <160>;
      hfront-porch = <160>;
      vsync-len = <1>;
      vback-porch = <23>;
      vfront-porch = <12>;
      hsync-active = <0>;
      vsync-active = <0>;
      de-active = <0>;
      pixelclk-active = <0>;
     };
    };

    ports {
     #address-cells = <1>;
     #size-cells = <0>;
     port@0 {
      reg = <0>;
      panel_in_dsi1: endpoint {
       remote-endpoint = <&dsi1_out_panel>;
      };
     };
    };
   };

   ports {
    #address-cells = <1>;
    #size-cells = <0>;

    port@1 {
     reg = <1>;
     dsi1_out_panel: endpoint {
      remote-endpoint = <&panel_in_dsi1>;
     };
    };
   };
  };
 };
};
