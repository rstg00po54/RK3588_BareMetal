# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-spi0-m2-overlay.dts"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-spi0-m2-overlay.dts"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 5 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-spi0-m2-overlay.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rockchip.h" 1
# 6 "arch/arm64/boot/dts/rockchip/overlay/rk3588-lubancat-spi0-m2-overlay.dts" 2

/ {
 fragment@0 {
  target = <&spi0>;

  __overlay__ {
   status = "okay";
   #address-cells = <1>;
   #size-cells = <0>;
   pinctrl-names = "default";
   pinctrl-0 = <&spi0m2_cs0 &spi0m2_cs1 &spi0m2_pins>;
   num-cs = <2>;

   spi_dev@0 {
    compatible = "rockchip,spidev";
    reg = <0>;
    spi-max-frequency = <24000000>;
   };

   spi_dev@1 {
    compatible = "rockchip,spidev";
    reg = <1>;
    spi-max-frequency = <24000000>;
   };
  };
 };
};
